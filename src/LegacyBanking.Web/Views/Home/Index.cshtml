@model BankingDashboardDto
@{
    ViewBag.Title = "Dashboard";
}
<section class="hero panel">
    <div>
        <div class="eyebrow">Branch operations</div>
        <h1>Retail banking dashboard</h1>
        <p>Track customer onboarding, deposits, transfers, and payments inside a single legacy monolith.</p>
    </div>
    <div class="hero-metrics">
        <div class="metric">
            <span>Customers</span>
            <strong>@Model.CustomerCount</strong>
        </div>
        <div class="metric">
            <span>Accounts</span>
            <strong>@Model.AccountCount</strong>
        </div>
        <div class="metric">
            <span>Assets</span>
            <strong>@String.Format("{0:C}", Model.TotalDeposits)</strong>
        </div>
        <div class="metric">
            <span>Withdrawals</span>
            <strong>@String.Format("{0:C}", Model.TotalWithdrawals)</strong>
        </div>
    </div>
</section>
<section class="grid two-up">
    <article class="panel">
        <h2>Featured Accounts</h2>
        <table class="data-table">
            <thead>
                <tr>
                    <th>Account</th>
                    <th>Owner</th>
                    <th>Type</th>
                    <th>Balance</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var account in Model.FeaturedAccounts)
                {
                    <tr>
                        <td>@account.AccountNumber</td>
                        <td>@account.CustomerName</td>
                        <td>@account.AccountType</td>
                        <td>@String.Format("{0:C}", account.Balance)</td>
                    </tr>
                }
            </tbody>
        </table>
    </article>
    <article class="panel">
        <h2>Recent Activity</h2>
        <table class="data-table">
            <thead>
                <tr>
                    <th>When</th>
                    <th>Reference</th>
                    <th>Type</th>
                    <th>Amount</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var transaction in Model.RecentTransactions)
                {
                    <tr>
                        <td>@transaction.PostedOn.ToLocalTime().ToString("g")</td>
                        <td>@transaction.ReferenceNumber</td>
                        <td>@transaction.TransactionType</td>
                        <td>@String.Format("{0:C}", transaction.Amount)</td>
                    </tr>
                }
            </tbody>
        </table>
    </article>
</section>
